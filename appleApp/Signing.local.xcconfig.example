// Copy this file to Signing.local.xcconfig (gitignored) and set your own team.
// The team ID is the ten-character identifier in
// `security find-identity -v -p codesigning`, or in Xcode → Settings → Accounts.
//
// Free Apple IDs work for a quick test but expire after 7 days; a paid Apple Developer
// Program membership signs for one year.
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Optional: for a local Developer ID macOS release (notarization), uncomment and fill in.
// CARDV_MACOS_SIGN_IDENTITY = Developer ID Application: Your Name (YOUR_TEAM_ID)
